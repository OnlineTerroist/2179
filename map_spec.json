{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 480,
  "projection": {
    "type": "mercator",
    "center": [
      144.8,
      -37.8
    ],
    "scale": 4500
  },
  "layer": [
    {
      "data": {
        "url": "melbourne_sa2.json",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#d4edf5",
        "stroke": "#9ec8d8",
        "strokeWidth": 0.6
      }
    },
    {
      "data": {
        "url": "calamari_occurrences.csv"
      },
      "transform": [
        {
          "filter": "datum.state === 'Victoria'"
        },
        {
          "filter": "datum.year !== ''"
        },
        {
          "calculate": "floor(datum.year / 10) * 10",
          "as": "decade"
        }
      ],
      "mark": {
        "type": "circle",
        "opacity": 0.75,
        "size": 60
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "color": {
          "field": "decade",
          "type": "ordinal",
          "title": "Decade",
          "scale": {
            "scheme": "blues"
          },
          "legend": {
            "orient": "bottom-right",
            "titleFontSize": 11
          }
        },
        "tooltip": [
          {
            "field": "locality",
            "title": "Location"
          },
          {
            "field": "year",
            "title": "Year"
          },
          {
            "field": "dataSource",
            "title": "Data source"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": "transparent"
    }
  }
}